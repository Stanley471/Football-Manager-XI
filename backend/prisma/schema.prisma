generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  club      Club?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Club {
  id        String @id @default(uuid())
  name      String
  shortName String
  balance   Int    @default(100000)

  userId  String? @unique
  manager User?   @relation(fields: [userId], references: [id])

  players ClubPlayer[]
  tactic  Tactic?

  homeFixtures Fixture[] @relation("HomeFixtures")
  awayFixtures Fixture[] @relation("AwayFixtures")

  transfersFrom Transfer[] @relation("TransfersFrom")
  transfersTo   Transfer[] @relation("TransfersTo")

  matchEvents MatchEvent[]
  transactions CoinTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model CoinTransaction {
  id          String   @id @default(uuid())
  clubId      String
  club        Club     @relation(fields: [clubId], references: [id])
  amount      Int
  type        String
  description String
  referenceId String?
  createdAt   DateTime @default(now())

  @@index([clubId])
}



model Player {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  position    String
  age         Int
  rating      Int
  marketValue Float    @default(0)

  clubMemberships ClubPlayer[]
  matchEvents     MatchEvent[]
  transfers       Transfer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClubPlayer {
  id          String   @id @default(uuid())
  clubId      String
  playerId    String
  shirtNumber Int
  isStarting  Boolean  @default(false)
  joinedAt    DateTime @default(now())

  club   Club   @relation(fields: [clubId], references: [id])
  player Player @relation(fields: [playerId], references: [id])

  @@unique([clubId, playerId])
  @@index([clubId])
  @@index([playerId])
}



model Tactic {
  id        String    @id @default(uuid())
  clubId    String    @unique
  formation String
  mentality String    @default("BALANCED")

  club Club @relation(fields: [clubId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



model Fixture {
  id          String        @id @default(uuid())
  homeClubId  String
  awayClubId  String
  scheduledAt DateTime
  status      String        @default("SCHEDULED")
  season      String

  homeClub Club   @relation("HomeFixtures", fields: [homeClubId], references: [id])
  awayClub Club   @relation("AwayFixtures", fields: [awayClubId], references: [id])
  match    Match?

  createdAt DateTime @default(now())

  @@index([homeClubId])
  @@index([awayClubId])
  @@index([scheduledAt])
  @@index([season])
}

model Match {
  id        String   @id @default(uuid())
  fixtureId String   @unique
  homeScore Int      @default(0)
  awayScore Int      @default(0)
  playedAt  DateTime @default(now())

  fixture Fixture      @relation(fields: [fixtureId], references: [id])
  events  MatchEvent[]
}



model MatchEvent {
  id       String         @id @default(uuid())
  matchId  String
  minute   Int
  type     String
  playerId String?
  clubId   String?

  match  Match   @relation(fields: [matchId], references: [id])
  player Player? @relation(fields: [playerId], references: [id])
  club   Club?   @relation(fields: [clubId], references: [id])

  @@index([matchId])
  @@index([playerId])
  @@index([clubId])
}

model Transfer {
  id            String   @id @default(uuid())
  playerId      String
  fromClubId    String?
  toClubId      String
  fee           Float
  transferredAt DateTime @default(now())

  player   Player @relation(fields: [playerId], references: [id])
  fromClub Club?  @relation("TransfersFrom", fields: [fromClubId], references: [id])
  toClub   Club   @relation("TransfersTo", fields: [toClubId], references: [id])

  @@index([playerId])
  @@index([fromClubId])
  @@index([toClubId])
}
